# Which data the app runs on. Copy to app/.env and rebuild (npx expo start --clear).
#   preview  (default) local mock data: nothing leaves the phone.
#   supabase the real backend (supabase/README.md). It never falls back to the preview.
EXPO_PUBLIC_APP_MODE=preview
EXPO_PUBLIC_SUPABASE_URL=
# The publishable key only (sb_publishable_…). Never a secret or service-role key,
# a database password or an SMS provider credential: everything here ships in the app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
