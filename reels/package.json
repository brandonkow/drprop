    "@remotion/player": "^4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/three": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
