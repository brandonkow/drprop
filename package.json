{
  "name": "drprop",
  "private": true,
  "type": "module",
  "workspaces": [
    "brand",
    "web",
    "app",
    "reels",
    "twin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "brand:build": "npm run build -w @drprop/brand",
    "dev": "npm run dev -w @drprop/web",
    "build": "npm run brand:build && npm run build -w @drprop/web",
    "preview": "npm run preview -w @drprop/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p brand && tsc -p web && tsc -p app --noEmit && tsc -p reels --noEmit && tsc -p twin --noEmit && tsc -p supabase && tsc -p app/test && tsc -p e2e",
    "app": "npm run start -w @drprop/app",
    "brand:3d": "npm run 3d -w @drprop/brand",
    "reels": "npm run studio -w @drprop/reels",
    "render:all": "npm run render:all -w @drprop/reels",
    "twin": "npm run dev -w @drprop/twin",
    "twin:build": "npm run build -w @drprop/twin",
    "build:production": "npm run brand:build && npm run build:production -w @drprop/web",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "verify:launch-guard": "node scripts/verify-launch-guard.mjs",
    "typecheck:edge": "npx --yes deno@2.9.6 check --frozen --config supabase/functions/case-files/deno.json supabase/functions/case-files/index.ts && npx --yes deno@2.9.6 check --frozen --config supabase/functions/payment-operations/deno.json supabase/functions/payment-operations/index.ts supabase/functions/stripe-checkout/index.ts supabase/functions/stripe-webhook/index.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.3",
    "axe-core": "^4.14.0",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "deepmerge": "file:vendor/deepmerge",
    "pdf-lib": "^1.17.1",
    "query-string": "^7.1.3",
    "stripe": "23.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "deepmerge": "$deepmerge",
    "fast-uri": "^3.1.9",
    "zod@>=4.0.0": "^4.6.7",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "glob": "^14.0.3",
    "minimatch@>=9": "^11.0.3",
    "node-forge": "^1.4.2",
    "@expo/config": {
      "deepmerge": "$deepmerge"
    },
    "@remotion/media": {
      "zod": "^4.6.7"
    },
    "@remotion/studio": {
      "zod": "^4.6.7"
    },
    "@remotion/studio-protocol": {
      "zod": "^4.6.7"
    },
    "@remotion/studio-server": {
      "zod": "^4.6.7"
    }
  }
}
