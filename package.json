{
  "name": "drprop",
  "private": true,
  "type": "module",
  "workspaces": [
    "brand",
    "web",
    "app",
    "reels",
    "twin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "brand:build": "npm run build -w @drprop/brand",
    "dev": "npm run dev -w @drprop/web",
    "build": "npm run brand:build && npm run build -w @drprop/web",
    "preview": "npm run preview -w @drprop/web",
    "test": "vitest run",
    "typecheck": "tsc -p brand && tsc -p web && tsc -p app --noEmit && tsc -p reels --noEmit && tsc -p twin --noEmit && tsc -p supabase && tsc -p app/test",
    "app": "npm run start -w @drprop/app",
    "brand:3d": "npm run 3d -w @drprop/brand",
    "reels": "npm run studio -w @drprop/reels",
    "render:all": "npm run render:all -w @drprop/reels",
    "twin": "npm run dev -w @drprop/twin",
    "twin:build": "npm run build -w @drprop/twin"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
